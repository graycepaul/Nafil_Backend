# Project: "Nafil DB" (ref itfepppqjtodmizbglze, eu-west-1)
SUPABASE_URL=https://itfepppqjtodmizbglze.supabase.co

# Secrets — copy from the Supabase dashboard, never commit the filled-in .env:
#   Service role key: Project Settings → API Keys → service_role (secret)
#   JWT secret:       Project Settings → API → JWT Settings → JWT Secret
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Project Settings → Database → Connection string → "Session pooler" tab.
# The direct host (db.itfepppqjtodmizbglze.supabase.co) doesn't resolve for
# this project — Supabase only exposes it over the pooler now — so this MUST
# be the pooler URL, not the direct one. Note the username becomes
# `postgres.<project-ref>` (not just `postgres`) for the pooler.
DATABASE_URL=postgresql://postgres.itfepppqjtodmizbglze:[YOUR-PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:5432/postgres

ENVIRONMENT=development

# Optional: scopes Expo push-send requests to this project (see
# app/core/config.py). Not required to send push at all.
EXPO_ACCESS_TOKEN=

# Shared secret the notifications-table trigger sends back to this service
# when it wants a push sent (see app/routers/push.py and
# supabase/migrations/0028_generic_push_notifications.sql). Generate one with
# `openssl rand -hex 32` and use the exact same value in both places — the
# migration's `vault.create_secret` call and this env var.
INTERNAL_PUSH_SECRET=
