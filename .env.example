# STALE - this file still describes the deprecated Supabase Cloud project
# ("Nafil DB", ref itfepppqjtodmizbglze). That project is now paused; nothing
# should point at it. Production/self-hosted config lives in
# deploy/self-hosted/.env.backend.example instead - copy that one for the
# VPS, not this one.
#
# What this file does NOT yet answer: how local development is meant to work
# now that Postgres isn't publicly reachable on the VPS (bound to 127.0.0.1
# by design, see deploy/self-hosted/nginx.conf and docker-compose.backend.yml).
# Either set up an SSH tunnel to the VPS's Postgres for local DATABASE_URL
# access, or run a separate local Supabase stack via Docker Compose mirroring
# production - this hasn't been decided yet. Don't fill in a DATABASE_URL
# here without resolving that first.
SUPABASE_URL=https://api.nafilestates.com

# Secrets - never commit the filled-in .env:
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# See the stale-file note above - not yet resolved for local dev.
DATABASE_URL=

ENVIRONMENT=development

# Optional: scopes Expo push-send requests to this project (see
# app/core/config.py). Not required to send push at all.
EXPO_ACCESS_TOKEN=

# Shared secret the notifications-table trigger sends back to this service
# when it wants a push sent (see app/routers/push.py and
# supabase/migrations/0028_generic_push_notifications.sql). Generate one with
# `openssl rand -hex 32` and use the exact same value in both places - the
# migration's `vault.create_secret` call and this env var.
INTERNAL_PUSH_SECRET=

# Optional: Sentry error tracking. Leave unset to disable (e.g. local dev).
# Get this from your Sentry project's Settings → Client Keys (DSN).
SENTRY_DSN=
