# Project: "Nafil DB" (ref itfepppqjtodmizbglze, eu-west-1)
SUPABASE_URL=https://itfepppqjtodmizbglze.supabase.co

# Secrets — copy from the Supabase dashboard, never commit the filled-in .env:
#   Service role key: Project Settings → API Keys → service_role (secret)
#   JWT secret:       Project Settings → API → JWT Settings → JWT Secret
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Project Settings → Database → Connection string → URI (use the pooler for serverless)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.itfepppqjtodmizbglze.supabase.co:5432/postgres

ENVIRONMENT=development
