# Self-hosted VPS values — same variables as ../../.env.example, pointed at
# your own domain and self-hosted Supabase stack instead of *.supabase.co.
# Copy to .env.backend on the server and fill in. Never commit the filled version.

# Your reverse-proxied domain — nginx.conf routes /auth, /rest, /storage,
# /realtime from this host to the self-hosted Kong gateway.
SUPABASE_URL=https://api.nafilestates.com

# From the self-hosted stack's own .env (generated when you set it up):
#   ANON_KEY / SERVICE_ROLE_KEY are printed by the supabase docker setup,
#   or derived from JWT_SECRET — see the self-hosted supabase repo's README.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Direct Postgres connection — on the VPS this talks to the `db` container
# over the shared nafil_net network, not a pooler.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db:5432/postgres

ENVIRONMENT=production

EXPO_ACCESS_TOKEN=

# Must match the value used in supabase/migrations/0028_generic_push_notifications.sql
# on this VPS's database (vault.create_secret) — generate with `openssl rand -hex 32`.
INTERNAL_PUSH_SECRET=

CORS_ORIGINS=["https://app.nafilestates.com"]
