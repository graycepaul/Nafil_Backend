# Self-hosted VPS values - same variables as ../../.env.example, pointed at
# your own domain and self-hosted Supabase stack instead of *.supabase.co.
# Copy to .env.backend on the server and fill in. Never commit the filled version.

# Your reverse-proxied domain - nginx.conf routes /auth, /rest, /storage,
# /realtime from this host to the self-hosted Kong gateway.
SUPABASE_URL=https://vps.nafilestates.com

# From the self-hosted stack's own .env (generated when you set it up):
#   ANON_KEY / SERVICE_ROLE_KEY are printed by the supabase docker setup,
#   or derived from JWT_SECRET - see the self-hosted supabase repo's README.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Direct Postgres connection - on the VPS this talks to the `db` container
# over the supabase_default network (created by the supabase stack's own
# `docker compose up`), not a pooler.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db:5432/postgres

# "self-hosted", not "production" - this tags errors in Sentry so they're
# never confused with the real production instance on Render.
ENVIRONMENT=self-hosted

EXPO_ACCESS_TOKEN=

# Must match the `internal_push_secret` value in this VPS's database vault
# (see supabase/migrations/0041_batch_push_notifications.sql, which rotates
# it and prints the new value via `raise notice` when applied - copy it from
# that migration's own psql output, don't generate a separate one here).
INTERNAL_PUSH_SECRET=

CORS_ORIGINS=["https://app.nafilestates.com"]

# uvicorn worker count (see Dockerfile). Guideline: 2x vCPU + 1. Leave unset
# to keep the current default of 2.
WEB_CONCURRENCY=

# Optional: Sentry error tracking. Leave unset to disable.
SENTRY_DSN=
